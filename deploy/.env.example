# Shared secret every client sends as the x-api-key header.
API_KEY=
# Public hostname served by Traefik (add it to your DNS / tunnel).
DOMAIN=gopay.beesatech.com
# Optional: only used by the gateway's own /create-qris.
QRIS_STATIC=
GOPAY_MERCHANT_ID=
# Infra — match your Traefik install.
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=cloudflare
